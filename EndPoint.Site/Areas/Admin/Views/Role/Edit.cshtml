@model Shop35_Store.Domain.Entities.Roles.EditRoleDto

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="h-100 d-flex align-items-center justify-content-center  ">
    <div class=" container p-2  border border-primary  text-center col-8">


        @if (ViewBag.Errors !=null)
        {
            <div class="alert alert-danger">
                @foreach (var item in ViewBag.Errors)
                {
                    <strong>@item.Description</strong>
                }
            </div>

        }

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
           
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control"/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="تبت تغییرات" class="btn btn-outline-primary" />
            </div>
        </form>
        <div>
            <a class="btn btn-outline-primary" asp-action="Index">برگشت به لیست</a>
        </div>
    </div>




</div>

