@model IEnumerable<Shop35_Store.Domain.Entities.Roles.RoleListDto>

@{
    ViewData["Title"] = "نقش کاربران";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="h-100 d-flex align-items-center justify-content-center  ">
    <div class=" container p-2  border border-primary  text-center col-8">
<p>
    <a asp-action="Create">افزودن نقش جدید</a>
</p>
        <table class="table table-hover table-bordered">
    <thead>
        <tr>
           
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                            @Html.ActionLink("ویرایش", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-warning" }) |
                            @Html.ActionLink("جزئیات", "Details", new { id = item.Id }, new { @class = "btn  btn-outline-info" }) |
                            @Html.ActionLink("حذف", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger" })|
                            @Html.ActionLink("لیست کاربر", "UserInRole", "Role", new { Name = item.Name, area = "Admin" }, new { @class = "btn btn-outline-secondary" })
            </td>
        </tr>
}
    </tbody>
</table>
</div>
</div>
