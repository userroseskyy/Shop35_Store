@model Shop35_Store.Domain.Entities.Roles.AddUserRoleDto

@{
    ViewData["Title"] = "AddUserRole";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="h-100 d-flex align-items-center justify-content-center  ">
    <div class=" container p-2  border border-secondary   text-center col-8">
        <form asp-action="AddUserRole">
            <p class="bg-primary text-light">
                شما قصد افزودن نقش  جدید به کاربر
                <text> @Model.FullName</text>
                <span>ایمیل</span>
            <text>@Model.Email</text>
                را دارید.


            </p>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">

                <input asp-for="Id" type="hidden" class="form-control"/>

            </div>
            <div class="form-group col-4">
                <label asp-for="Role" class="control-label"></label>
                <select asp-for="Role" asp-items="Model.Roles" class="form-control"></select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="form-group ">
                <input type="submit" value="ثبت نقش کاربر" class="btn btn-primary "/>
            </div>
        </form>
   

<div >
    <a class="btn btn-outline-primary " asp-action="Index">برگشت به لیست</a>
</div>

</div>