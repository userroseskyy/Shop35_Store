@model Shop35_Store.Domain.Entities.Users.UserDetailDto

@{
    ViewData["Title"] = "جزئیات کاربر";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="h-100 d-flex align-items-center justify-content-center  ">
    <div class=" container p-2  border border-primary  text-center col-8">

        <table class="table   table-hover">
            <thead >
                <tr>
                    <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                    <th> @Html.DisplayNameFor(model => model.lastName)</th>
                    <th> @Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.UserName)</th>
                    <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Html.DisplayFor(model => model.FirstName)</td>
                    <td> @Html.DisplayFor(model => model.lastName)</td>
                    <td> @Html.DisplayFor(model => model.Email)</td>
                    <td> @Html.DisplayFor(model => model.UserName)</td>
                    <td> @Html.DisplayFor(model => model.PhoneNumber)</td>

                </tr>
            </tbody>
        </table>



<div class="mx-auto text-center">
            @Html.ActionLink("ویرایش", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-primary" }) |
    <a class="btn btn-outline-primary" asp-action="Index">برگشت به لیست</a>
        </div>
    </div>
</div>