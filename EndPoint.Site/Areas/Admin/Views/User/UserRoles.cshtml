@model IList<string>
@{
    ViewData["Title"] = "UserRoles";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<div class="container">
<table class="table table-bordered table-hover ">
    <thead>
        <tr>
      
      
            <th scope="col">
                <a asp-action="Index">  @ViewBag.UserInfo</a>
                </th>
                <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        <tr>


            @foreach (var item in Model)
            {
            <tr>

                <td>
            @item
                </td>
                
                <td>
                    <button class="btn btn-danger btn-sm delete-role" data-role="@item">حذف</button>
                </td>
            </tr>
            }
           
        </tr>
       
    </tbody>
</table>
</div>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script>
    $(document).ready(function () {
        $(".delete-role").click(function () {
            var role = $(this).data("role");
            var row = $(this).closest("tr"); 

            if (confirm("آیا مطمئن هستید که می‌خواهید این نقش را حذف کنید؟")) {
                $.ajax({
                    type: "POST",
                    url: "/Admin/User/DeleteRole",
                    data: { role: role },
                    success: function (data) {
                        if (data.success) {
                          
                            row.remove();
                        } else {
                            alert("خطا در حذف نقش: " + data.error);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error(xhr.responseText);
                    }
                });
            }
        });
    });
</script>
