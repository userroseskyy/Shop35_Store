@model IList<string>
@{
    ViewData["Title"] = "UserRoles";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<div class="container">
<table class="table table-bordered table-hover ">
    <thead>
        <tr>
      
      
            <th scope="col">
                <a asp-action="Index">  @ViewBag.UserInfo</a>
                </th>
                <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        <tr>


            @foreach (var item in Model)
            {
            <tr>

                <td>
            @item
                </td>
                
                <td>
                    <button class="btn btn-danger btn-sm delete-role" data-role="@item">حذف</button>
                </td>
            </tr>
            }
           
        </tr>
       
    </tbody>
</table>
</div>

