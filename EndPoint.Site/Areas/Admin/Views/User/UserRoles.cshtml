@model IList<string>
@{
    ViewData["Title"] = "UserRoles";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<div class="container">
<table class="table table-bordered table-hover ">
    <thead>
        <tr>
      
      
            <th scope="col">
                <a asp-action="Index">  @ViewBag.UserInfo</a>
                </th>
                <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        <tr>


            @foreach (var item in Model)
            {
            <tr>

                <td>
            @item
                </td>
                
                <td>
                    <button class="btn btn-danger btn-sm delete-role" data-role="@item">حذف</button>
                </td>
            </tr>
            }
           
        </tr>
       
    </tbody>
</table>
</div>
@section Scripts
{

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $(".delete-role").click(function () {
                var role = $(this).data("role");
                var row = $(this).closest("tr");




                swal.fire({
                    title: 'حذف نقش',
                    text: "کاربر گرامی از حذف نقش مطمئن هستید؟",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#7cacbe',
                    confirmButtonText: 'بله ، نقش حذف شود',
                    cancelButtonText: 'خیر'
                }).then((result) => {
                    if (result.value) {
                        // انجام عملیات حذف
                        var postData = {
                            'role': role,
                        };

                        $.ajax({
                            type: "POST",
                            url: "/Admin/User/DeleteRole",
                            data: postData,
                            success: function (data) {
                                if (data.success) {
                                    row.remove();
                                } else {
                                    alert("خطا در حذف نقش: " + data.error);
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error(xhr.responseText);
                            }
                        });
                    }
                });
            });
        });
    </script>
}