@model Shop35_Store.Domain.Entities.Account.VerifyPhoneNumber

@{
    ViewData["Title"] = "VerifyPhoneNumber";
    Layout = null;
}

<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/font-awesome.min.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/materialdesignicons.css">
<!-- plugin-------------------------------------->
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/bootstrap.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/owl.carousel.min.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/nice-select.css">
<!-- main-style---------------------------------->
<link rel="stylesheet" href="~/SiteTemplate/assets/css/main.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/responsive.css">
<link href="~/sitetemplate/assets/css/stylesheet.css" rel="stylesheet" />





<div class="h-100 d-flex align-items-center justify-content-center  ">
    <div class=" container p-5 bg-primary    text-center col-4 ">
        <h1>تأیید شماره تلفن</h1>

       <h4>کد ارسال شده به موبایل خود را وارد نمائید.</h4>
        <h2>@Model.PhoneNumber</h2>
          <hr />
    
           
        <form asp-action="VerifyPhoneNumber">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
               
                <input asp-for="PhoneNumber" type="hidden" class="form-control" />
               
            </div>
            <div class="form-group">
                <label asp-for="Code" class="control-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="تائید" class="btn btn-light" />
            </div>
        </form>
        <a class="btn btn-warning" asp-area="" asp-controller="Home" asp-action="Index">برگشت به صفحه اصلی</a>
    </div>
</div>