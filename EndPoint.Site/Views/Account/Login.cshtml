@model Shop35_Store.Domain.Entities.Users.UserLoginDto

@{
    Layout = null;
}

<html>
<head>
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/font-awesome.min.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/materialdesignicons.css">
<!-- plugin-------------------------------------->
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/bootstrap.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/owl.carousel.min.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/vendor/nice-select.css">
<!-- main-style---------------------------------->
<link rel="stylesheet" href="~/SiteTemplate/assets/css/main.css">
<link rel="stylesheet" href="~/SiteTemplate/assets/css/responsive.css">
<link href="~/sitetemplate/assets/css/stylesheet.css" rel="stylesheet" />



    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
</head>

<body >


        
    <div class="row  ">
        <div class="col-md-4  mx-auto p-5 my-5 border  text-white bg-dark  ">
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserName" class="control-label"></label>
                <input asp-for="UserName" class="form-control" />

                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="form-group">
            <a asp-area="" asp-controller="account" asp-action="Forgotpassword" class="pl">فراموشی رمز ایمیل</a>
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
                <div class="container  ">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="d-flex justify-content-center ">
                                <div class="form-group ">
                                    <label asp-for="IsPersistent" class="control-label"></label>
                                    <input asp-for="IsPersistent" class="form-control" />
                                    <span asp-validation-for="IsPersistent" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <div class="form-group">
               
                    <input asp-for="ReturnUrl" type="hidden" class="form-control" />
                  
            </div>
            <div class="form-group container">
                    <input type="submit" value="ورود" class="btn btn-primary row col-md-12 " />
            </div>
                    </form>
      

           
            <br />
            <a asp-area="" asp-controller="Home" asp-action="Index" >برگشت به صفحه اصلی</a>
            <a asp-area="" asp-controller="account" asp-action="register" class=" pl">ایجاد حساب کاربری</a>
    </div>
</div>



</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
