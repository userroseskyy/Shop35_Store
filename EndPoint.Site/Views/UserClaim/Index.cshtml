@model IEnumerable<System.Security.Claims.Claim>
@{
    ViewData["Title"] = "Index";
    Layout = null;

}

<div class="container">
   
<div class="h-100 d-flex align-items-center justify-content-center  ">





        
<table class="table table-hover table-bordered">
            <thead>
                <tr>
                    <th  colspan="5">
                        <a class="btn btn-outline-primary" asp-action="Create">افزودن Claim به کاربر</a>
                        <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="User" asp-action="Index">برگشت به صفحه اصلی</a>
                    </th>
                </tr>
                <tr>
                    <th>Subject</th>
                    <th>Issuer</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Delete</th>
                </tr>
            </thead>

    @foreach(var item in Model){
      <tr>
     <td>@item.Subject.Name</td>
        <td>@item.Issuer</td>
        <td>@item.Type</td>
        <td>@item.Value</td>
        <td>
          <a  asp-action="Delete" asp-route-ClaimType="@item.Type" class="btn btn-danger">حذف</a>
        </td>
    </tr>
    }
</table>
  </div>
</div>

<link rel="stylesheet" href="~/siteTemplate/assets/css/vendor/font-awesome.min.css">
